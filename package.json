{
  "name": "pstack-pi",
  "private": true,
  "version": "0.1.0",
  "description": "Lauren Tan's pstack for Pi: upstream skills unmodified, a Pi adapter skill, pi-subagents agents, and a /poteto toggle.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs"
  },
  "pi": {
