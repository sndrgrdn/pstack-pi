      "./upstream/skills",
      "./team-kit",
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
